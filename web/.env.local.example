# beehiiv REST API key — get from https://app.beehiiv.com/settings/integrations/api
BEEHIIV_API_KEY=

# Vercel Blob token — auto-set by Vercel when you connect a Blob store
# For local dev: copy from Vercel dashboard → Storage → your store → .env.local
BLOB_READ_WRITE_TOKEN=

# Team password for the dashboard and API (any username works)
SENA_DASHBOARD_PASSWORD=
